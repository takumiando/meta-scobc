	mram0: mram@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0 1>;
		parallel-memories = <0x0 0x04000000 0x0 0x04000000>;
		spi-tx-bus-width = <1>;
