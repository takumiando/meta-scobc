*/

&qspi {
	status = "okay";

	num-cs = <1>;
	is-dual = <0>;
	xlnx,connection-mode = <0>;
	xlnx,qspi-mode = <0>;

	spi-tx-bus-width = <1>;
	spi-rx-bus-width = <4>;

	flash@0 {
		reg = <0>;

		/delete-property/ parallel-memories;

		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <40000000>;
	};
};
