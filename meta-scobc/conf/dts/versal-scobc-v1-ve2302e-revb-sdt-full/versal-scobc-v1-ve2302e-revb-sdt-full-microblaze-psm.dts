                                #interrupt-cells = <0x1>;
                                #address-cells = <0x0>;
                                interrupt-controller;
                        };
                };
        };

        versal_noc_ddr_memory: memory@00000000 {
                phandle = <0x3>;
                compatible = "xlnx,axi-noc-1.1";
                xlnx,ip-name = "axi_noc";
                device_type = "memory";
                reg = <0x0 0x0 0x0 0x80000000>;
                memory_type = "memory";
