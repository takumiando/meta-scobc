From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Takumi Ando <takumi@spacecubics.com>
Date: Tue, 15 Sep 2026 10:30:00 +0900
Subject: [PATCH] assists: xlnx-overlay: Fix QDMA host register regions

The QDMA node generated by SDT can contain its bridge CSR, outbound
memory window, and ECAM configuration window in the reg property.  The
Linux QDMA host binding expects only the ECAM and bridge CSR regions,
named "cfg" and "breg" respectively.  Passing the outbound window as a
register region also shifts the names onto the wrong resources.

When generating a Linux PL overlay, remove reg regions which duplicate
the parent address and size of a ranges entry.  Sort the two remaining
regions by size so the ECAM window precedes the smaller bridge CSR
region, and assign the binding-defined names.  This derives the layout
from the SDT address assignments instead of hard-coding board-specific
addresses.

Signed-off-by: Takumi Ando <takumi@spacecubics.com>
---
 lopper/assists/xlnx_overlay_pl_dt.py | 114 +++++++++++++++++++++++++++
 1 file changed, 114 insertions(+)

diff --git a/lopper/assists/xlnx_overlay_pl_dt.py b/lopper/assists/xlnx_overlay_pl_dt.py
index b019b47..1b2d842 100644
--- a/lopper/assists/xlnx_overlay_pl_dt.py
+++ b/lopper/assists/xlnx_overlay_pl_dt.py
@@ -157,6 +157,119 @@ def add_status_disabled_after_ipname(filepath, match_list):
         f.writelines(modified_lines)
 
 
+def _cells_to_int(cells):
+    value = 0
+    for cell in cells:
+        value = (value << 32) | cell
+    return value
+
+
+def _format_reg_regions(indent, regions):
+    formatted = []
+    for region in regions:
+        cells = " ".join(f"0x{cell:x}" for cell in region)
+        formatted.append(f"<{cells}>")
+    return f"{indent}reg = " + (f",\n{indent}\t").join(formatted) + ";"
+
+
+def _normalize_qdma_host_block(block, platform):
+    """Convert QDMA address regions to the Linux host binding layout."""
+    if "xlnx,qdma-host-3.00" not in block:
+        return block
+
+    reg_match = re.search(r"(?m)^(?P<indent>[ \t]*)reg\s*=\s*(?P<value>.*?);", block,
+                          re.DOTALL)
+    ranges_match = re.search(r"(?m)^[ \t]*ranges\s*=\s*(?P<value>.*?);", block,
+                             re.DOTALL)
+    names_match = re.search(r"(?m)^[ \t]*reg-names\s*=\s*.*?;", block,
+                            re.DOTALL)
+    if not reg_match or not ranges_match or not names_match:
+        return block
+
+    reg_cells = [int(value, 0) for value in
+                 re.findall(r"0[xX][0-9a-fA-F]+|\b\d+\b",
+                            reg_match.group("value"))]
+    ranges_cells = [int(value, 0) for value in
+                    re.findall(r"0[xX][0-9a-fA-F]+|\b\d+\b",
+                               ranges_match.group("value"))]
+
+    parent_address_cells = 1 if platform == "Zynq" else 2
+    parent_size_cells = 1 if platform == "Zynq" else 2
+    pci_address_cells = 3
+    reg_stride = parent_address_cells + parent_size_cells
+    ranges_stride = pci_address_cells + parent_address_cells + parent_size_cells
+
+    if len(reg_cells) % reg_stride or len(ranges_cells) % ranges_stride:
+        return block
+
+    reg_regions = [reg_cells[offset:offset + reg_stride]
+                   for offset in range(0, len(reg_cells), reg_stride)]
+    outbound_regions = set()
+    for offset in range(0, len(ranges_cells), ranges_stride):
+        parent_offset = offset + pci_address_cells
+        address = ranges_cells[parent_offset:
+                               parent_offset + parent_address_cells]
+        size_offset = parent_offset + parent_address_cells
+        size = ranges_cells[size_offset:size_offset + parent_size_cells]
+        outbound_regions.add((_cells_to_int(address), _cells_to_int(size)))
+
+    host_regions = []
+    for region in reg_regions:
+        address = region[:parent_address_cells]
+        size = region[parent_address_cells:]
+        if (_cells_to_int(address), _cells_to_int(size)) not in outbound_regions:
+            host_regions.append(region)
+
+    if len(host_regions) != 2:
+        return block
+
+    # ECAM configuration space is larger than the bridge CSR region.
+    host_regions.sort(
+        key=lambda region: _cells_to_int(region[parent_address_cells:]),
+        reverse=True)
+
+    block = (block[:reg_match.start()] +
+             _format_reg_regions(reg_match.group("indent"), host_regions) +
+             block[reg_match.end():])
+    names_match = re.search(r"(?m)^(?P<indent>[ \t]*)reg-names\s*=\s*.*?;",
+                            block, re.DOTALL)
+    block = (block[:names_match.start()] +
+             f'{names_match.group("indent")}reg-names = "cfg", "breg";' +
+             block[names_match.end():])
+    return block
+
+
+def normalize_qdma_host_regs(filepath, platform):
+    """Normalize all QDMA host nodes in a generated PL overlay."""
+    with open(filepath, "r") as f:
+        content = f.read()
+
+    node_starts = []
+    qdma_node_starts = set()
+    qdma_nodes = []
+    for match in re.finditer(r"\{|\}|xlnx,qdma-host-3\.00", content):
+        token = match.group(0)
+        if token == "{":
+            node_starts.append(match.start())
+        elif token == "xlnx,qdma-host-3.00":
+            if node_starts:
+                qdma_node_starts.add(node_starts[-1])
+        elif token == "}":
+            if not node_starts:
+                continue
+            start = node_starts.pop()
+            if start in qdma_node_starts:
+                qdma_nodes.append((start, match.end()))
+
+    for start, end in reversed(qdma_nodes):
+        content = (content[:start] +
+                   _normalize_qdma_host_block(content[start:end], platform) +
+                   content[end:])
+
+    with open(filepath, "w") as f:
+        f.write(content)
+
+
 """
 This API generates the overlay dts file by taking pl.dtsi
 generated from DTG++.
@@ -448,6 +561,7 @@ def xlnx_generate_overlay_dt(tgt_node, sdt, options):
 
     remove_status_okay(output_file)
     add_status_disabled_after_ipname(output_file, match_list)
+    normalize_qdma_host_regs(output_file, platform)
 
     # Copy contents from pl.dtsi to pl.dtso in the same directory
     dtso_file = os.path.join(sdt.outdir, 'pl.dtso')
-- 
2.51.2
